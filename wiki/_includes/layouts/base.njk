<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'">
    <meta name="description" content="{{ (brief or description or 'Research notes with preserved sources.') | escape }}">
    {% if rkey %}<meta name="research-turn-rkey" content="{{ rkey | escape }}">{% endif %}
    <title>{% if title %}{{ title | escape }} · {% endif %}Smith Wiki</title>
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body{% if rkey %} class="research-page"{% endif %}>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Smith Wiki home">Smith<span>Wiki</span></a>
      <nav aria-label="Primary navigation">
        <a href="/">Index</a>
        <a href="/log/">Research log</a>
      </nav>
    </header>
    <main id="main-content">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>Evidence-led research with sources kept in view.</p>
    </footer>
  </body>
</html>
