---
layout: layouts/base.njk
---
{% if mode == "SOURCE_BRIEF" %}
  {% set mode_label = "Source brief" %}
{% elif mode == "QUESTION_ANSWER" %}
  {% set mode_label = "Question answer" %}
{% elif mode == "NOTE_EXPLORE" %}
  {% set mode_label = "Note exploration" %}
{% else %}
  {% set mode_label = "Research" %}
{% endif %}
<article class="wiki-card">
  <header class="page-heading">
    <p class="eyebrow">Research &middot; {{ mode_label }}</p>
    <h1>{{ title | escape }}</h1>
    <p class="byline">
      {% if date %}<time datetime="{{ date | machineDate | escape }}">{{ date | displayDate | escape }}</time>{% endif %}
      {% if turn_url %}<a href="{{ turn_url | escape }}" rel="external">Turn issue</a>{% endif %}
    </p>
    <p class="dek">{{ brief | escape }}</p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
