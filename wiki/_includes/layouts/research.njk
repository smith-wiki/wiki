---
layout: layouts/base.njk
---
{% if mode == "SOURCE_BRIEF" %}
  {% set mode_label = "Source brief" %}
{% elif mode == "QUESTION_ANSWER" %}
  {% set mode_label = "Question answer" %}
{% elif mode == "NOTE_EXPLORE" %}
  {% set mode_label = "Note exploration" %}
{% else %}
  {% set mode_label = "Research" %}
{% endif %}
<article class="research-card" data-research-turn="{{ rkey | escape }}" data-research-mode="{{ mode | escape }}">
  <header class="research-heading">
    <div class="research-kicker">
      <span class="research-mode-label"><span>Research mode</span> {{ mode_label }}</span>
      {% if date %}<time datetime="{{ date | machineDate | escape }}">{{ date | displayDate | escape }}</time>{% endif %}
    </div>
    <h1>{{ title | escape }}</h1>
  </header>
  <div class="prose research-body">
    {{ content | safe }}
  </div>
  <footer class="turn-footer">
    <span>Turn {{ rkey | escape }}</span>
    {% if turn_url %}<a href="{{ turn_url | escape }}" rel="external">Original Bluesky post</a>{% endif %}
  </footer>
</article>
