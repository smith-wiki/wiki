#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Smith Wiki helper

Usage:
  sw                                   Show wiki pages, open threads, Issues, and pull requests.
  sw fetch URL [SOURCE] [--file FILE] [--recapture]
                                       Capture and index a source, or return the current capture of an
                                       already captured URL; --recapture replaces it. With SOURCE, record
                                       it in wiki/sources/SOURCE.md.
  sw fetch --hash SHA                  Restore a stored capture into the local cache.
  sw search QUERY [--in sources|wiki] [--limit N]
                                       Search current captures and wiki pages on origin/main.
  sw search --sync                     Maintenance: index every current capture and wiki page and drop
                                       everything else; needed after the chunking or model changes.
  sw search-eval [--chunkers A,B] [--models M,N]
                                       Maintenance: measure chunkers and embedding models on Key points.
  sw turn [--queue] (--new-thread | THREAD) SLUG TITLE REQUEST
                                       Open a research turn: Issue in the thread milestone and branch.
  sw task [--queue] SLUG TITLE REQUEST Open a repository task: Issue and branch.
  sw start ISSUE SLUG                  Start work on a queued Issue.
  sw commit MESSAGE [PATH...]          Stage PATHs (default: every change), tidy wiki pages, check links
                                       and ASCII, and commit (Conventional Commits).
  sw pr TITLE BODY                     Push and open a pull request that closes the current Issue.
  sw checks [PR]                       Wait for pull request checks; print OK or the failed checks.
  sw sync                              Rebase a stacked turn onto its dependency's current base.
  sw merge [PR]                        Wait for checks, then merge an explicitly authorized pull request;
                                       a stacked turn is merged together with the turns beneath it.

THREAD is a milestone number, title, or URL. --new-thread creates a milestone
named after TITLE. --queue records the Issue without creating a branch.
Text must be English; typographic quotes and dashes become ASCII.
FILE is a copy of URL saved from a browser.
EOF
}

die() {
  printf 'sw: %s\n' "$*" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository"
cd "$repo_root"
ascii_checker="$repo_root/scripts/check_ascii.py"
tidy="$repo_root/scripts/tidy.py"
[[ -f "$ascii_checker" ]] || die "missing scripts/check_ascii.py"

check_text() {
  python3 "$ascii_checker" --text "$1" "$2"
}

require_english() {
  check_text "$1" "$2" || die "$1 must be English; translate the user's words"
}

fold_typography() {
  python3 "$tidy" --text "$1"
}

require_clean() {
  [[ -z $(git status --porcelain) ]] || die "$1"
}

load_lines() {
  local array_name=$1 label=$2 output
  shift 2
  output=$("$@") || die "$label"
  mapfile -t "$array_name" </dev/null
  [[ -z "$output" ]] || mapfile -t "$array_name" <<<"$output"
}

validate_slug() {
  [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
    die "SLUG must use lowercase ASCII words and hyphens"
}

current_repo() {
  gh repo view --json nameWithOwner --jq .nameWithOwner || die "could not identify GitHub repository"
}

milestone_title=""

resolve_milestone() {
  local repo=$1 reference=$2 number milestone_json
  if [[ "$reference" =~ /milestone/([0-9]+)$ ]]; then
    number=${BASH_REMATCH[1]}
  elif [[ "$reference" =~ ^[0-9]+$ ]]; then
    number=$reference
  else
    number=$(gh api "repos/$repo/milestones?state=open&per_page=100" |
      jq -r --arg title "$reference" '[.[] | select(.title == $title)][0].number // empty')
    [[ -n "$number" ]] || return 1
  fi
  milestone_json=$(gh api "repos/$repo/milestones/$number") || return 1
  [[ $(jq -r .state <<<"$milestone_json") == open ]] || return 1
  milestone_title=$(jq -r .title <<<"$milestone_json")
}

create_milestone() {
  local repo=$1 title=$2 milestone_json
  milestone_json=$(gh api --method POST "repos/$repo/milestones" -f title="$title") ||
    die "could not create thread milestone"
  milestone_title=$(jq -r .title <<<"$milestone_json")
}

issue_dependency() {
  jq -r '.body | try capture("(?m)^## Depends on\\r?\\n\\r?\\n(?<value>[^\\r\\n]*)").value // empty' <<<"$1"
}

base_for_dependency() {
  local dependency=$1 pr_json
  if [[ "$dependency" =~ /pull/([0-9]+)$ ]]; then
    pr_json=$(gh pr view "${BASH_REMATCH[1]}" --json headRefName,state) ||
      die "could not resolve dependency $dependency"
    case $(jq -r .state <<<"$pr_json") in
      OPEN) jq -r .headRefName <<<"$pr_json" ;;
      MERGED) printf 'main' ;;
      *) die "dependency $dependency is closed without merge" ;;
    esac
  else
    printf 'main'
  fi
}

switch_to_issue_branch() {
  local issue=$1 slug=$2 base=$3
  [[ "$base" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ && "$base" != *..* ]] ||
    die "base is not a safe branch name: $base"
  git fetch --quiet origin "$base"
  git switch -c "issue/$issue-$slug" "origin/$base"
}

current_issue_context() {
  current_branch=$(git branch --show-current)
  [[ "$current_branch" =~ ^issue/([0-9]+)-[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
    die "current branch must be issue/<number>-<slug>"
  current_issue=${BASH_REMATCH[1]}
  current_issue_json=$(gh issue view "$current_issue" --json body,milestone,state) ||
    die "could not read issue #$current_issue"
  [[ $(jq -r .state <<<"$current_issue_json") == OPEN ]] || die "issue #$current_issue is not open"
}

print_limited() {
  local limit=$1 label=$2
  shift 2
  local items=("$@") total=$# index
  printf '%-14s: ' "$label"
  if (( total == 0 )); then
    printf 'none\n'
    return
  fi
  for ((index = 0; index < total && index < limit; index++)); do
    (( index == 0 )) || printf ', '
    printf '%s' "${items[index]}"
  done
  (( total <= limit )) || printf ', ... (+%d more)' "$((total - limit))"
  printf '\n'
}

command_overview() {
  local limit=20 branch dirty role repo path title
  local -a items
  branch=$(git branch --show-current)
  dirty=""
  [[ -z $(git status --porcelain) ]] || dirty=" dirty"
  printf 'Smith Wiki | %s%s\n' "${branch:-detached}" "$dirty"

  for role in research sources entities concepts notes; do
    items=()
    while IFS= read -r path; do
      [[ "${path##*/}" == index.md ]] && continue
      title=$(grep -m 1 '^title:' "$path" || true)
      title=${title#title:}
      title=${title# }
      title=${title#[\"\']}
      title=${title%[\"\']}
      path=${path##*/}
      items+=("$title [${path%.md}]")
    done < <(git ls-files "wiki/$role/*.md" | sort)
    print_limited "$limit" "$role" "${items[@]}"
  done

  if ! gh auth status >/dev/null 2>&1; then
    printf 'GitHub: unavailable; run gh auth login\n'
    return
  fi
  repo=$(current_repo)
  load_lines items "could not list milestones" \
    gh api "repos/$repo/milestones?state=open&per_page=100" \
    --jq '.[] | "#\(.number) \(.title) [\(.open_issues) open/\(.closed_issues) closed]"'
  print_limited "$limit" Milestones "${items[@]}"
  load_lines items "could not list Issues" \
    gh issue list --state open --limit 100 --json number,title,milestone \
    --jq '.[] | "#\(.number) \(.title)" + (if .milestone then " [" + .milestone.title + "]" else "" end)'
  print_limited "$limit" Issues "${items[@]}"
  load_lines items "could not list pull requests" \
    gh pr list --state open --limit 100 --json number,title,headRefName \
    --jq '.[] | "#\(.number) \(.title) [" + .headRefName + "]"'
  print_limited "$limit" "Pull requests" "${items[@]}"
}

command_open() {
  local kind=$1 queue=false selector="" slug title request repo body issue_url
  local dependency="" base=main latest
  local -a args
  shift
  if [[ ${1:-} == --queue ]]; then
    queue=true
    shift
  fi
  if [[ "$kind" == turn ]]; then
    (( $# == 4 )) || die "usage: sw turn [--queue] (--new-thread | THREAD) SLUG TITLE REQUEST"
    selector=$1
    shift
  else
    (( $# == 3 )) || die "usage: sw task [--queue] SLUG TITLE REQUEST"
  fi
  slug=$1
  title=$(fold_typography "$2")
  request=$(fold_typography "$3")
  validate_slug "$slug"
  [[ -n "$request" ]] || die "REQUEST must not be empty"
  require_english TITLE "$title"
  require_english REQUEST "$request"
  [[ "$queue" == true ]] || require_clean "commit or discard tracked changes before starting work"

  repo=$(current_repo)
  if [[ "$kind" == turn ]]; then
    if [[ "$selector" == --new-thread ]]; then
      create_milestone "$repo" "$title"
    else
      resolve_milestone "$repo" "$selector" || die "thread not found or not open: $selector"
    fi
    latest=$(gh pr list --state open --limit 100 --json url,headRefName,milestone,createdAt |
      jq -c --arg title "$milestone_title" \
        '[.[] | select(.milestone.title? == $title)] | sort_by(.createdAt) | last // empty')
    if [[ -n "$latest" ]]; then
      dependency=$(jq -r .url <<<"$latest")
      base=$(jq -r .headRefName <<<"$latest")
    fi
  fi

  body="## Request"$'\n\n'"$request"
  [[ -z "$dependency" ]] || body+=$'\n\n'"## Depends on"$'\n\n'"$dependency"
  check_text issue-body "$body"
  args=(issue create --title "$title" --body "$body")
  [[ -z "$milestone_title" ]] || args+=(--milestone "$milestone_title")
  issue_url=$(gh "${args[@]}") || die "could not create Issue"
  printf '%s\n' "$issue_url"
  [[ "$queue" == true ]] || switch_to_issue_branch "${issue_url##*/}" "$slug" "$base"
}

# Every worktree reads the .env of the primary worktree.
with_secrets() {
  local reason=$1 primary
  shift
  primary=$(git rev-parse --path-format=absolute --git-common-dir) || die "could not locate the primary worktree"
  secretspec run --provider "dotenv:${primary%/.git}/.env" --reason "$reason" -- "$@"
}

command_fetch() {
  with_secrets "sw fetch: capture a research source into the private R2 store and index it" \
    python3 "$repo_root/scripts/fetch.py" "$@"
}

command_search() {
  with_secrets "sw search: search captured sources and wiki pages" \
    python3 "$repo_root/scripts/search.py" "$@"
}

command_search_eval() {
  with_secrets "sw search-eval: measure chunkers and embedding models on the wiki's Key points" \
    python3 "$repo_root/scripts/search_eval.py" "$@"
}

command_start() {
  (( $# == 2 )) || die "usage: sw start ISSUE SLUG"
  local issue=$1 slug=$2 issue_json
  [[ "$issue" =~ ^[0-9]+$ ]] || die "ISSUE must be a number"
  validate_slug "$slug"
  require_clean "commit or discard tracked changes before starting work"
  issue_json=$(gh issue view "$issue" --json body,state) || die "could not read issue #$issue"
  [[ $(jq -r .state <<<"$issue_json") == OPEN ]] || die "issue #$issue is not open"
  switch_to_issue_branch "$issue" "$slug" "$(base_for_dependency "$(issue_dependency "$issue_json")")"
}

command_commit() {
  (( $# >= 1 )) || die "usage: sw commit MESSAGE [PATH...]"
  local message
  message=$(fold_typography "$1")
  shift
  check_text commit-message "$message"
  [[ "$message" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?:\ [[:alnum:]] ]] ||
    die "commit message must follow Conventional Commits"
  if (( $# == 0 )); then git add -A; else git add -- "$@"; fi
  ! git diff --cached --quiet || die "nothing to commit"
  local -a pages=()
  local page
  while IFS= read -r page; do pages+=("$page"); done < <(git diff --cached --name-only --diff-filter=AMR -- 'wiki/*.md')
  if (( ${#pages[@]} > 0 )); then
    python3 "$tidy" "${pages[@]}" || die "fix the links above, then commit again"
    git add -- "${pages[@]}"
  fi
  git diff --cached --check
  python3 "$ascii_checker" --staged
  git commit -m "$message"
}

command_pr() {
  (( $# == 2 )) || die "usage: sw pr TITLE BODY"
  local title summary dependency base milestone body
  title=$(fold_typography "$1")
  summary=$(fold_typography "$2")
  local -a args
  check_text pr-title "$title"
  require_clean "commit all tracked changes before opening a pull request"
  current_issue_context
  milestone=$(jq -r '.milestone.title // empty' <<<"$current_issue_json")
  dependency=$(issue_dependency "$current_issue_json")
  base=$(base_for_dependency "$dependency")
  git fetch --quiet origin "$base"
  python3 "$ascii_checker" --range "origin/$base...HEAD"
  python3 "$ascii_checker" --commits "origin/$base..HEAD"

  body="Closes #$current_issue"
  [[ -z "$dependency" ]] || body+=$'\n'"Depends on $dependency"
  body+=$'\n\n'"$summary"
  check_text pr-body "$body"

  git push -u origin "$current_branch"
  args=(pr create --base "$base" --head "$current_branch" --title "$title" --body "$body")
  [[ -z "$milestone" ]] || args+=(--milestone "$milestone")
  gh "${args[@]}"
}

command_checks() {
  (( $# <= 1 )) || die "usage: sw checks [PR]"
  local deadline=$((SECONDS + 1800)) json failed
  while :; do
    json=$(gh pr checks "$@" --json name,bucket,link 2>/dev/null || true)
    if [[ -n "$json" ]] && jq -e 'length > 0 and all(.bucket != "pending")' <<<"$json" >/dev/null; then
      break
    fi
    (( SECONDS < deadline )) || die "checks still pending after 30 minutes"
    sleep 10
  done
  failed=$(jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | "\(.name): \(.link)"' <<<"$json")
  if [[ -n "$failed" ]]; then
    printf 'failed checks:\n%s\n' "$failed"
    return 1
  fi
  printf 'OK\n'
}

command_sync() {
  (( $# == 0 )) || die "usage: sw sync"
  local dependency base
  require_clean "commit all tracked changes before syncing"
  current_issue_context
  dependency=$(issue_dependency "$current_issue_json")
  [[ -n "$dependency" ]] || die "current Issue has no pull request dependency"
  base=$(base_for_dependency "$dependency")
  git fetch --quiet origin "$base"
  git rebase "origin/$base"
  git push --force-with-lease -u origin "$current_branch"
  gh pr edit --base "$base"
}

command_merge() {
  (( $# <= 1 )) || die "usage: sw merge [PR]"
  local pr=${1:-} n base out attempt
  local -a chain=()
  if [[ -z "$pr" ]]; then
    pr=$(gh pr view --json number --jq .number) || die "current branch has no pull request"
  fi
  # A stacked turn targets the previous turn's branch; merge the stack bottom up so every turn lands on main.
  n=$pr
  while :; do
    chain=("$n" "${chain[@]}")
    base=$(gh pr view "$n" --json baseRefName --jq .baseRefName) || die "could not read pull request #$n"
    [[ "$base" == main ]] && break
    n=$(gh pr list --head "$base" --state open --json number --jq '.[0].number // empty')
    [[ -n "$n" ]] || die "#${chain[0]} targets $base, which has no open pull request; run sw sync"
  done
  for n in "${chain[@]}"; do
    if ! out=$(command_checks "$n"); then
      printf '%s\n' "$out"
      die "not merging #$n"
    fi
    [[ "$n" == "${chain[0]}" ]] || gh pr edit "$n" --base main >/dev/null
    # gh prints worktree cleanup advice when the branch is checked out here; the session keeps its worktree.
    for attempt in 1 2 3; do
      if out=$(gh pr merge "$n" --merge --delete-branch 2>&1); then
        break
      fi
      (( attempt < 3 )) || { printf '%s\n' "$out" >&2; die "could not merge #$n"; }
      sleep 10
    done
    printf 'merged #%s\n' "$n"
  done
}

if (( $# == 0 )); then
  command_overview
  exit
fi

command=$1
shift
for arg in "$@"; do
  [[ "$arg" == -h || "$arg" == --help ]] && { usage; exit; }
done
case "$command" in
  help|-h|--help) usage ;;
  turn|task) command_open "$command" "$@" ;;
  fetch) command_fetch "$@" ;;
  search) command_search "$@" ;;
  search-eval) command_search_eval "$@" ;;
  start) command_start "$@" ;;
  commit) command_commit "$@" ;;
  pr) command_pr "$@" ;;
  checks) command_checks "$@" ;;
  sync) command_sync "$@" ;;
  merge) command_merge "$@" ;;
  *) die "unknown command: $command; run 'sw help'" ;;
esac
